&gt;&#xA;&lt;/html&gt;&#xA;&#xA;&lt;br&gt;&#xA;&lt;!DOCTYPE html&gt;&#xA;&lt;html&gt;&#xA;&lt;head&gt;&#xA;  &lt;meta charset=&#34;UTF-8&#34;&gt;&#xA;  &lt;title&gt;code&lt;/title&gt;&#xA;  &lt;style&gt;&#xA;    pre {&#xA;        margin: 0;&#xA;        padding: 0;&#xA;    }&#xA;&#xA;    code {&#xA;        display: block;&#xA;    }&#xA;  &lt;/style&gt;  &#xA;&lt;/head&gt;&#xA;&#xA;&lt;body&gt;&#xA;&#xA;&lt;pre&gt;&#xA;  &lt;code id=&#34;code&#34;&gt;&lt;/code&gt;  &#xA;&lt;/pre&gt;&#xA;&#xA;&lt;script&gt;&#xA;  const url = &#34;https:\/\/raw.githubusercontent.com\/juneleung\/bsDoubIMDB\/main\/find_imdb_douban_by_filmname.py&#34;;&#xA;&#xA;  fetch(url)&#xA;    .then(response =&gt; response.text()) &#xA;    .then(code =&gt; {&#xA;      document.getElementById(&#34;code&#34;).textContent = code;&#xA;    });&#xA;&lt;/script&gt;&#xA;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;&#xA;&lt;hr&gt;&#xA;&lt;p&gt;@juneleung&lt;/p&gt;</description>
